# Salin berkas ini menjadi .env sebelum menjalankan aplikasi.

# Lokasi berkas database SQLite (tidak butuh server database terpisah).
DATABASE_URL="file:./dev.db"

# Kunci rahasia untuk menandatangani cookie sesi admin.
# Ganti dengan string acak yang panjang saat digunakan sungguhan.
SESSION_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"
